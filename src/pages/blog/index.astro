---
import Document from '@/layouts/Document.astro';
import BlogListing from '@/components/BlogListing.astro';
import { getAllBlogPosts } from '@/views/api';
import { metadata as defaults } from '@/lib/site-metadata';
import { metadata } from '@/lib/blog-metadata';
const posts = await getAllBlogPosts();
---
<Document metadata={{ ...defaults, ...metadata }} pathname={Astro.url.pathname}>
  <BlogListing posts={posts} />
</Document>
